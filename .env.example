# Supabase -> Project Settings -> API. Copy this file to .env.local and fill in.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Drive folder for uploaded tax invoices (the id at the end of the folder's URL).
GOOGLE_DRIVE_FOLDER_ID=1xG-vG5F52iLyJNPXdfQ0YbfqwUJmTAS2
# Sign-in, option A (Google Workspace + Shared Drive): the service account's JSON key, on one line.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Sign-in, option B (personal Gmail): OAuth client + a refresh token for the account that owns the folder.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
